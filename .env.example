# ------------------------------------------------------------------
# Authward environment variables (copy to .env.local and fill in)
# Never commit real values. Placeholders only.
# ------------------------------------------------------------------

# PostgreSQL connection string used by Prisma + the pg pool (src/lib/db/prisma.ts).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/authward

# HMAC secret used to sign the pending-verification cookie (src/lib/auth/cookies.ts).
# Generate with: openssl rand -hex 32  (must be set or the app throws at runtime)
AUTH_SECRET=replace-with-a-random-64-hex-character-string

# --- SMTP (src/lib/email/mailer.ts) ---
# If SMTP_* are unset, mail is logged to the console and not delivered (dev mode).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-an-smtp-password
SMTP_SECURE=false
# Optional: the From address shown in delivered mail (defaults to SMTP_USER).
#SMTP_FROM=Authward <no-reply@example.com>

# Optional: base URL used to build the password-reset link (defaults to http://localhost:3000).
#APP_BASE_URL=http://localhost:3000
